// APIWatch - Prisma Database Schema
// Multi-tenant API monitoring & reliability schema for PostgreSQL 16

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Native PostgreSQL Enums
enum MembershipRole {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum MonitorType {
  HTTP
  HTTPS
  TCP
  PING
  DNS
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  DEGRADED
  DOWN
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Multi-tenant Organization Model
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  customRoles  CustomRole[]
  invitations  Invitation[]
  apiKeys      ApiKey[]
  monitors     Monitor[]
  checkResults CheckResult[]
  incidents    Incident[]
  auditLogs    AuditLog[]
  keys         OrganizationKey[]

  @@map("organizations")
}

// User Model with Authentication & Verification
model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String
  name                   String?
  emailVerified          Boolean   @default(false)
  emailVerifyToken       String?   @unique
  emailVerifyExpiresAt   DateTime?
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?
  totpSecret             String?   // AES-256-GCM encrypted via packages/vault
  totpEnabled            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  invitationsCreated Invitation[]      @relation("InvitedByUser")
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]

  @@map("users")
}

// Organization Custom Roles for Granular Permissions
model CustomRole {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  permissions    Json     // JSONB array: ["monitors:read", "monitors:create", ...]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("custom_roles")
}

// Organization Membership (Tenant RBAC: OWNER | ADMIN | ENGINEER | VIEWER or custom role)
model Membership {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole  @default(VIEWER)
  customRoleId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([customRoleId])
  @@map("memberships")
}

// Rotating Refresh Token for HTTP-only Secure Cookie Flow
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  family    String   // UUID token family for rotation & replay detection
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// Organization Invitation Model
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           MembershipRole   @default(VIEWER)
  customRoleId   String?
  token          String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// Hashed Scoped API Key for Tenant Automation
model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  keyHash        String    @unique // SHA-256 hash of secret key
  keyPrefix      String    // e.g. "ak_live_abc123" for identification
  scopes         Json      // JSONB array: ["monitors:read", "monitors:write"]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

// Monitored API Endpoint
model Monitor {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  url             String
  type            MonitorType   @default(HTTP)
  method          HttpMethod    @default(GET)
  intervalSeconds Int           @default(60)
  timeoutSeconds  Int           @default(30)
  headers         Json?         // JSONB: headers
  body            Json?         // JSONB: payload
  assertionConfig Json?         // JSONB: assertion rules
  status          MonitorStatus @default(ACTIVE)
  encryptedAuth   String?       // AES-256-GCM encrypted credentials via packages/vault
  lastCheckedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  incidents    Incident[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("monitors")
}

// Check Result (High-volume time series data)
model CheckResult {
  id             String   @id @default(uuid())
  organizationId String
  monitorId      String
  statusCode     Int
  responseTimeMs Int
  isSuccess      Boolean
  errorMessage   String?
  timing         Json?    // JSONB: dns, connect, ttfb, total timings
  headers        Json?    // JSONB: response headers
  region         String   @default("us-east-1")
  checkedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

// Incident Lifecycle Model
model Incident {
  id             String           @id @default(uuid())
  organizationId String
  monitorId      String
  status         IncidentStatus   @default(OPEN)
  severity       IncidentSeverity @default(HIGH)
  title          String
  summary        String?
  rootCause      String?
  startedAt      DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([monitorId])
  @@map("incidents")
}

// Audit Log for Tenant Security
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  userAgent      String?
  before         Json?    // JSONB: redacted state before action
  after          Json?    // JSONB: redacted state after action
  details        Json?    // JSONB: contextual audit event details
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@map("audit_logs")
}

// Tenant Key Management for Envelope Encryption (packages/vault)
model OrganizationKey {
  id             String    @id @default(uuid())
  organizationId String
  keyVersion     Int       @default(1)
  encryptedKey   String    // AES-256-GCM encrypted DEK under master key
  masterKeyId    String    @default("v1")
  algorithm      String    @default("aes-256-gcm")
  status         String    @default("ACTIVE") // ACTIVE | RETIRED | REVOKED
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyVersion])
  @@index([organizationId])
  @@map("organization_keys")
}
