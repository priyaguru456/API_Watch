// APIWatch - Prisma Database Schema
// Multi-tenant API monitoring & reliability schema for PostgreSQL 16

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Native PostgreSQL Enums
enum MembershipRole {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum MonitorType {
  HTTP
  HTTPS
  TCP
  PING
  DNS
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  DEGRADED
  DOWN
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Multi-tenant Organization Model
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  monitors     Monitor[]
  checkResults CheckResult[]
  incidents    Incident[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

// User Model
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  refreshTokens RefreshToken[]
  invitationsCreated Invitation[] @relation("InvitedByUser")
  auditLogs    AuditLog[]

  @@map("users")
}

// Organization Membership (Tenant RBAC: OWNER | ADMIN | ENGINEER | VIEWER)
model Membership {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// Rotating Refresh Token for HTTP-only Secure Cookie Flow
model RefreshToken {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  family       String   // UUID token family for rotation & replay detection
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// Organization Invitation Model
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           MembershipRole   @default(VIEWER)
  token          String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// Monitored API Endpoint
model Monitor {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  url             String
  type            MonitorType   @default(HTTP)
  method          HttpMethod    @default(GET)
  intervalSeconds Int           @default(60)
  timeoutSeconds  Int           @default(30)
  headers         Json?         // JSONB: headers
  body            Json?         // JSONB: payload
  assertionConfig Json?         // JSONB: assertion rules
  status          MonitorStatus @default(ACTIVE)
  encryptedAuth   String?       // AES-256-GCM encrypted credentials at rest
  lastCheckedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  incidents    Incident[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("monitors")
}

// Check Result (High-volume time series data)
model CheckResult {
  id             String   @id @default(uuid())
  organizationId String
  monitorId      String
  statusCode     Int
  responseTimeMs Int
  isSuccess      Boolean
  errorMessage   String?
  timing         Json?    // JSONB: dns, connect, ttfb, total timings
  headers        Json?    // JSONB: response headers
  region         String   @default("us-east-1")
  checkedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

// Incident Lifecycle Model
model Incident {
  id             String           @id @default(uuid())
  organizationId String
  monitorId      String
  status         IncidentStatus   @default(OPEN)
  severity       IncidentSeverity @default(HIGH)
  title          String
  summary        String?
  rootCause      String?
  startedAt      DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([monitorId])
  @@map("incidents")
}

// Audit Log for Tenant Security
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?    // JSONB: contextual audit event details
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
