# ==============================================================================
# APIWatch Environment Configuration Template
# Copy this file to .env in local development
# ==============================================================================

# Application & Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/apiwatch?schema=public

# Cache & Queues (Redis 7)
REDIS_URL=redis://localhost:6379

# Security & Authentication
# JWT Secret (minimum 32 characters)
JWT_SECRET=apiwatch_dev_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key for secrets at rest (64 hex characters = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
