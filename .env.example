# ==============================================================================
# APIWatch — Root Environment Configuration Template (.env.example)
# Copy this file to backend/.env and frontend/.env and configure values.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/apiwatch_db?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api/v1
